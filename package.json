{
  "name": "docstatsai-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tsc": "tsc --noEmit",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "format": "prettier --write",
    "storybook": "ng run docstatsai-frontend:storybook",
    "build-storybook": "ng run docstatsai-frontend:build-storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "latest",
    "@angular-devkit/architect": "^0.2201.3",
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular-devkit/core": "^22.1.3",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/animations": "^22.1.3",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@chromatic-com/storybook": "latest",
    "@compodoc/compodoc": "latest",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/angular-vite": "^10.5.10",
    "@types/node": "^20",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.9.0",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.3.0",
    "playwright": "latest",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "storybook": "^10.5.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "latest",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{scss,css}": [
      "npm run format"
    ]
  }
}
